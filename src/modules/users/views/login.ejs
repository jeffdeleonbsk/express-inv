  
  <!-- Login Container -->
  <div
    x-data="{ modalOpen: false }" 
    class="w-full max-w-md bg-white p-8 rounded-lg shadow-lg">

    <!-- Title -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-semibold text-gray-700">Login to Your Account</h2>
      <p class="text-gray-500 text-sm">Please enter your credentials to continue.</p>
    </div>

    <!-- Login Form -->
    <form @submit.prevent="modalOpen = true">
      <!-- Email Field -->
      <div class="mb-4">
        <label for="email" class="block text-sm font-semibold text-gray-700">Email Address</label>
        <input type="email" id="email" required placeholder="Enter your email" class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>

      <!-- Password Field -->
      <div class="mb-6">
        <label for="password" class="block text-sm font-semibold text-gray-700">Password</label>
        <input type="password" id="password" required placeholder="Enter your password" class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>

      <!-- Submit Button -->
      <div class="flex justify-center">
        <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
          Login
        </button>
      </div>
    </form>

    <!-- Forgot Password -->
    <div class="text-center mt-4">
      <a href="#" class="text-blue-600 text-sm hover:underline">Forgot password?</a>
    </div>
  <!-- Modal Window (Error Handling) -->
  <div
    x-show="modalOpen"
    x-transition
    class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
  >
    <div
      @click.outside="modalOpen = false"
      class="bg-white w-full max-w-md p-6 rounded shadow-xl"
    >
      <h2 class="text-xl font-semibold mb-4">Login Error</h2>
      <p class="mb-4 text-gray-600">Invalid email or password. Please try again.</p>
      <div class="flex justify-end gap-2">
        <button @click="modalOpen = false" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">Close</button>
      </div>
    </div>
  </div>   
  </div>

 