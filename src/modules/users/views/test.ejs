      <main class="flex-1 p-6 overflow-auto" x-data="{modalOpen: false}">
        <div class="mb-6">
          <button
            @click="modalOpen = true"
            class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700"
          >
            Open Modal
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-lg font-semibold mb-2">Users</h2>
            <p class="text-3xl font-bold text-blue-600">1,234</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-lg font-semibold mb-2">Sales</h2>
            <p class="text-3xl font-bold text-green-600">$12,345</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-lg font-semibold mb-2">Orders</h2>
            <p class="text-3xl font-bold text-purple-600">543</p>
          </div>
        </div>
        <!-- Modal Window -->
        <div
            x-show="modalOpen"
            x-transition
            class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
        >
            <div
            @click.outside="modalOpen = false"
            class="bg-white w-full max-w-md p-6 rounded shadow-xl"
            >
            <h2 class="text-xl font-semibold mb-4">Confirmation</h2>
            <p class="mb-4">Are you sure you want to perform this action?</p>
            <div class="flex justify-end gap-2">
                <button @click="modalOpen = false" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">Cancel</button>
                <button @click="modalOpen = false" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Confirm</button>
            </div>
            </div>
        </div>           
      </main>
    