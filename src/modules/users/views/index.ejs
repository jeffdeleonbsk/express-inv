

<% if (result) { %>
    <h2>USERS</h2>
    <p>id <%= result.id %></p>
    <p>first <%= result.firstname %></p>
    <p>last <%= result.lastname %></p>
    <p>email <%= result.email %></p>
    <p>role <%= result.role %></p>
    <p>status <%= result.status %></p>
<% } else { %>
    <h2>Previous values</h2>
    <p>first <%= previous.firstname %></p>
    <p>last <%= previous.lastname %></p>
    <p>email <%= previous.email %></p>  
<% } %>    