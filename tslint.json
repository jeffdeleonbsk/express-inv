{
  "defaultSeverity": "error",
  "extends" : [
    "tslint:recommended"
  ],
  "jsRules" : {},
  "rules" : {
    "trailing-comma": [false],
    "max-classes-per-file": false,
    "no-console": false,
    "object-literal-sort-keys": false, 
    "variable-name": [
      true,
      "ban-keywords",
      "check-format",
      "allow-leading-underscore"
    ],
    "max-line-length": [false] 
  },
  "rulesDirectory" : []
}